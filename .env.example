# API Settings
PROJECT_NAME="AI Lecture Notes Platform"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/lecture_notes"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_BACKEND="local"
STORAGE_LOCAL_PATH="./storage"
STORAGE_BUCKET_NAME="lecture-notes-artifacts"
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Media
MEDIA_TEMP_DIR="./tmp/media"
MEDIA_MAX_DURATION_SECONDS=14400

# Transcription (faster-whisper)
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# AI Provider: "nvidia" (default), "openai", or "google"
AI_PROVIDER="nvidia"

# NVIDIA NIM (default provider)
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_TEXT_MODEL="openai/gpt-oss-20b"

# OpenAI (alternative provider)
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-4o"

# Google AI (alternative provider)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL="gemini-1.5-flash"

AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=3
